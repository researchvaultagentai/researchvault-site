{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "researchvault-support",
  "main": "index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "ai": { "binding": "AI" },
  "vars": {
    "SUPPORT_ENABLED": "false",
    "SUPPORT_ALLOWED_ORIGINS": "https://researchvaultagent.ir,https://www.researchvaultagent.ir,https://researchvault-patent.pages.dev"
  },
  "d1_databases": [
    { "binding": "SUPPORT_DB", "database_name": "researchvault-support-db", "migrations_dir": "migrations" }
  ],
  "triggers": { "crons": [] }
}
