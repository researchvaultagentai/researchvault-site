{
  "name": "researchvault-paper-infra",
  "private": true,
  "version": "0.1.0-stage1",
  "type": "module",
  "scripts": {
    "check:static": "node scripts/validate-stage1.mjs",
    "check:bundle:source01": "wrangler deploy --dry-run -c wrangler.source-01.jsonc",
    "check:bundle:source02": "wrangler deploy --dry-run -c wrangler.source-02.jsonc",
    "check:bundle:source03": "wrangler deploy --dry-run -c wrangler.source-03.jsonc",
    "check:bundle:source04": "wrangler deploy --dry-run -c wrangler.source-04.jsonc",
    "check:bundle:source05": "wrangler deploy --dry-run -c wrangler.source-05.jsonc",
    "check:bundle:source06": "wrangler deploy --dry-run -c wrangler.source-06.jsonc",
    "check:bundle:source07": "wrangler deploy --dry-run -c wrangler.source-07.jsonc",
    "check:bundle:sources": "npm run check:bundle:source01 && npm run check:bundle:source02 && npm run check:bundle:source03 && npm run check:bundle:source04 && npm run check:bundle:source05 && npm run check:bundle:source06 && npm run check:bundle:source07",
    "check:bundle:pdf": "wrangler deploy --dry-run -c wrangler.pdf-finder.jsonc",
    "check:bundle:doi": "wrangler deploy --dry-run -c wrangler.doi-resolver.jsonc",
    "check:bundle:smoke": "wrangler deploy --dry-run -c wrangler.smoke-gateway.jsonc",
    "check:bundle:smoke-domain": "wrangler deploy --dry-run -c wrangler.smoke-gateway-domain.jsonc",
    "check:bundle": "npm run check:bundle:sources && npm run check:bundle:pdf && npm run check:bundle:doi",
    "check": "npm run check:static && npm run check:bundle",
    "deploy:source01": "wrangler deploy -c wrangler.source-01.jsonc",
    "deploy:source02": "wrangler deploy -c wrangler.source-02.jsonc",
    "deploy:source03": "wrangler deploy -c wrangler.source-03.jsonc",
    "deploy:source04": "wrangler deploy -c wrangler.source-04.jsonc",
    "deploy:source05": "wrangler deploy -c wrangler.source-05.jsonc",
    "deploy:source06": "wrangler deploy -c wrangler.source-06.jsonc",
    "deploy:source07": "wrangler deploy -c wrangler.source-07.jsonc",
    "deploy:sources": "npm run deploy:source01 && npm run deploy:source02 && npm run deploy:source03 && npm run deploy:source04 && npm run deploy:source05 && npm run deploy:source06 && npm run deploy:source07",
    "deploy:pdf": "wrangler deploy -c wrangler.pdf-finder.jsonc",
    "deploy:doi": "wrangler deploy -c wrangler.doi-resolver.jsonc",
    "deploy:all": "npm run deploy:sources && npm run deploy:pdf && npm run deploy:doi",
    "smoke:deploy": "wrangler deploy -c wrangler.smoke-gateway.jsonc",
    "smoke:deploy:domain": "wrangler deploy -c wrangler.smoke-gateway-domain.jsonc",
    "smoke:delete": "wrangler delete -c wrangler.smoke-gateway.jsonc --name rv-paper-smoke-gateway",
    "smoke:delete:domain": "wrangler delete -c wrangler.smoke-gateway-domain.jsonc --name rv-paper-smoke-gateway"
  },
  "devDependencies": {
    "wrangler": "4.147.0"
  }
}
